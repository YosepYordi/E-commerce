              "raw": "{{baseUrl}}/api/cart",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cart"]
            }
          }
        },
        {
          "name": "Agregar Producto al Carrito",
          "event": [
            {
              "listen": "test",
