# Copy this file to .env and replace every change_me value.
DB_URL=jdbc:mysql://localhost:3306/ecommerce_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=ecommerce_app
DB_PASSWORD=change_me
MYSQL_DATABASE=ecommerce_db
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_PORT=3306

# Use at least 32 random bytes, encoded as Base64.
JWT_SECRET_BASE64=replace_with_a_base64_secret_of_at_least_32_bytes
JWT_EXPIRATION_SECONDS=3600
ADMIN_USERNAME=admin
# Generate with BCrypt; do not commit a real administrative credential.
ADMIN_PASSWORD_HASH=replace_with_a_bcrypt_hash
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
